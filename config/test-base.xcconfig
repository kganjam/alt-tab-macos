// docs: https://help.apple.com/xcode/mac/11.4/#/itcaec37c2a6

SWIFT_VERSION = 5.8
// Xcode 27 rejects deployment targets below 12.0; raising ours from 10.12 surfaced pre-existing
// deprecations (NSAppearance.current, ultraDark/mediumLight materials, NSStatusItem.popUpMenu) that
// warnings-as-errors turned into build failures. Modernizing them changes the panel's material and the
// menubar menu's behaviour, so do it deliberately, not as fallout of an OS upgrade. We pass
// -warnings-as-errors ourselves (instead of SWIFT_TREAT_WARNINGS_AS_ERRORS) because the exemption only
// applies if it comes AFTER it on the command line; every other warning is still an error.
SWIFT_TREAT_WARNINGS_AS_ERRORS = NO
OTHER_SWIFT_FLAGS = -warnings-as-errors -Wwarning DeprecatedDeclaration
CODE_SIGNING_REQUIRED = NO // no need for codesign
CODE_SIGNING_ALLOWED = NO // no need for codesign
ONLY_ACTIVE_ARCH = YES // only need to run on the host machine
ENABLE_BITCODE = NO
GCC_GENERATE_TEST_COVERAGE_FILES = NO
GCC_INSTRUMENT_PROGRAM_FLOW_ARCS = NO
TEST_ATTACHMENT_LOGGING = NO
DEAD_CODE_STRIPPING = YES
